{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Centerly (UI preview \u2014 offline)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define=CENTERLY_UI_PREVIEW=true"
      ]
    },
    {
      "name": "dev",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define-from-file=.env.dev.json",
        "--dart-define=CENTERLY_UI_PREVIEW=false",
        "--dart-define=CENTERLY_FINANCE_MOVEMENT_FILTERS=true"
      ]
    },
    {
      "name": "prod",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define-from-file=.env.prod.json",
        "--dart-define=CENTERLY_UI_PREVIEW=false",
        "--dart-define=CENTERLY_FINANCE_MOVEMENT_FILTERS=true"
      ]
    }
  ]
}
